# DATABASE_URL takes precedence when set; otherwise use the POSTGRES_* fields.
DATABASE_URL=
# Leave AUTH_REQUIRED=false for the local demo. Production defaults to required.
APP_ENV=development
AUTH_REQUIRED=false
# Clerk backend verification settings. Never put secret keys in frontend variables.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CLERK_AUDIENCE=
# Comma-separated trusted browser origins; do not use a wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Local development API. For a deployed API, set its HTTPS /api URL in Vercel.
# When unset in production, the UI uses simulated demo data if same-origin API
# requests are unavailable.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Clerk publishable keys are public; never add CLERK_SECRET_KEY to VITE_*.
VITE_CLERK_PUBLISHABLE_KEY=
